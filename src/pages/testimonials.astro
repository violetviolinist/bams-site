---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
import '../styles/global.css';
---

<BaseLayout title="Testimonials">
  <!-- Page Header -->
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Testimonials</h1>
      <p class="text-xl text-white/70 max-w-2xl mx-auto">
        What our participants and HR partners say about our programs.
      </p>
    </div>
  </section>

  <ComingSoon
    title="Testimonials Coming Soon"
    message="We're gathering feedback from our corporate workshop participants. Check back soon for testimonials from HR leaders and training participants."
  />
</BaseLayout>
