---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout title="Corporate Workshops">
  <!-- Page Header -->
  <section class="bg-navy text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Corporate Workshops</h1>
      <p class="text-xl text-white/70 max-w-2xl mx-auto">
        Evidence-based programs for corporate mind management and human performance.
      </p>
    </div>
  </section>

  <!-- Workshops -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16">

        <!-- Workshop 1 -->
        <div class="max-w-4xl mx-auto">
          <div class="border-l-4 border-teal pl-8">
            <span class="text-sm font-medium text-teal uppercase tracking-wider">Workshop 1</span>
            <h2 class="text-2xl md:text-3xl font-bold text-navy mt-2 mb-4">Mind Mastery for Peak Performance</h2>
            <p class="text-navy/70 text-lg mb-6">
              A full-day immersive program that equips professionals with practical tools to manage attention,
              regulate emotions, and maintain clarity under pressure. Designed for teams operating in high-stakes environments.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Attention management techniques</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Emotional regulation strategies</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Clarity under pressure</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Thought pattern optimization</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Workshop 2 -->
        <div class="max-w-4xl mx-auto">
          <div class="border-l-4 border-teal pl-8">
            <span class="text-sm font-medium text-teal uppercase tracking-wider">Workshop 2</span>
            <h2 class="text-2xl md:text-3xl font-bold text-navy mt-2 mb-4">Stress Management & Nervous System Reset</h2>
            <p class="text-navy/70 text-lg mb-6">
              A science-backed program addressing the root causes of workplace stress. Participants learn practical
              breathwork, meditation, and somatic techniques they can apply immediately. Highly relevant for teams
              facing burnout.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Breathwork techniques</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Guided meditation practices</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Somatic relaxation methods</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Burnout prevention strategies</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Workshop 3 -->
        <div class="max-w-4xl mx-auto">
          <div class="border-l-4 border-teal pl-8">
            <span class="text-sm font-medium text-teal uppercase tracking-wider">Workshop 3</span>
            <h2 class="text-2xl md:text-3xl font-bold text-navy mt-2 mb-4">Time Management & Mental Focus</h2>
            <p class="text-navy/70 text-lg mb-6">
              A practical workshop on sustaining deep focus, effective prioritization, and building cognitive
              endurance in distraction-heavy corporate environments.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Deep work strategies</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Prioritization frameworks</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Cognitive endurance building</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2.5 shrink-0"></span>
                <span class="text-navy/70">Distraction management</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Workshop 4 -->
        <div class="max-w-4xl mx-auto">
          <div class="border-l-4 border-gold pl-8">
            <span class="text-sm font-medium text-gold uppercase tracking-wider">Experiential Session</span>
            <h2 class="text-2xl md:text-3xl font-bold text-navy mt-2 mb-4">Meditation for Corporate Wellness</h2>
            <p class="text-navy/70 text-lg mb-6">
              A 2-hour experiential workshop introducing practical, non-religious meditation techniques specifically
              adapted for corporate professionals. An ideal entry point for organisations exploring wellness initiatives.
            </p>
            <div class="inline-block bg-cream rounded-md px-4 py-2">
              <span class="text-sm font-medium text-navy/70">Duration: 2 hours &bull; Experiential format</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-16 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-navy mb-6">Workshop Investment</h2>
        <div class="bg-white rounded-lg shadow-sm p-8 border border-navy/10">
          <div class="text-4xl font-bold text-navy mb-2">&#8377;50,000</div>
          <p class="text-navy/60 mb-6">Full-day onsite workshop (up to 10 participants)</p>
          <div class="border-t border-navy/10 pt-6">
            <p class="text-navy/70">
              <strong class="text-navy">&#8377;5,000</strong> per additional participant (above 10, up to 20 max)
            </p>
          </div>
          <div class="mt-8">
            <a href="/contact" class="inline-block bg-navy hover:bg-navy-light text-white font-semibold px-8 py-3 rounded-md transition-colors">
              Book a Corporate Discussion
            </a>
          </div>
        </div>
        <p class="text-sm text-navy/50 mt-6">
          All workshops are conducted onsite at your premises or a venue of your choice.
          Custom programs available on request.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
