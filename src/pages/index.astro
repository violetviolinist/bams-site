---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const clients = [
  'Siemens Ltd',
  'Pidilite Industries',
  'IOCL',
  'BPCL',
  'BEST, Mumbai',
  'BGR Energy Systems',
  'Doosan Infracore India',
  'Coromandel Engineering',
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative bg-navy text-white py-20 lg:py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-dark to-navy opacity-90"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-gold font-medium text-sm uppercase tracking-wider mb-4">Established 1986</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        Transforming Minds at Work<br class="hidden md:block" /> Since 1986
      </h1>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto mb-4">
        Corporate Mind Management & Human Performance Training
      </p>
      <p class="text-base text-white/60 max-w-2xl mx-auto mb-10">
        Stress Management &bull; Mind Mastery &bull; Emotional Resilience &bull; Meditation-Based Wellness Programs
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-block bg-gold hover:bg-gold-light text-navy font-semibold px-8 py-3 rounded-md transition-colors">
          Book a Corporate Discussion
        </a>
        <a href="/workshops" class="inline-block border border-white/30 hover:border-white text-white font-semibold px-8 py-3 rounded-md transition-colors">
          Explore Workshops
        </a>
      </div>
    </div>
  </section>

  <!-- Legacy Section -->
  <section class="py-20 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-6">A Legacy of Excellence</h2>
        <p class="text-lg text-navy/70 mb-8">
          Founded in 1986 by Shri R. K. Rawat (MBA, IIM Calcutta), Bombay Academy of Management Studies
          has trained professionals across India's leading corporations in management, finance, international trade,
          and leadership skills.
        </p>
        <p class="text-lg text-navy/70 mb-8">
          Today, BAMS evolves to address the modern workplace's greatest challenge &mdash;
          the human mind. Our programs integrate management science with evidence-based stress management,
          breathwork, and mind mastery techniques to build resilient, high-performing teams.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
          <div class="text-center">
            <div class="text-3xl font-bold text-teal">38+</div>
            <div class="text-sm text-navy/60 mt-1">Years of Experience</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-teal">25+</div>
            <div class="text-sm text-navy/60 mt-1">Training Programs</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-teal">10+</div>
            <div class="text-sm text-navy/60 mt-1">Major Corporates</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-teal">IIM</div>
            <div class="text-sm text-navy/60 mt-1">Faculty Pedigree</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Workshops -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy mb-4">Current Workshop Offerings</h2>
        <p class="text-lg text-navy/60 max-w-2xl mx-auto">
          Evidence-based programs designed for corporate teams seeking peak performance and emotional resilience.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Workshop 1 -->
        <div class="bg-white border border-navy/10 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-full bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-3">Mind Mastery for Peak Performance</h3>
          <p class="text-navy/60 mb-4">Attention management, emotional regulation, clarity under pressure, and thought pattern optimization.</p>
          <a href="/workshops" class="text-teal font-medium text-sm hover:text-teal-light transition-colors">Learn more &rarr;</a>
        </div>

        <!-- Workshop 2 -->
        <div class="bg-white border border-navy/10 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-full bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-3">Stress Management & Nervous System Reset</h3>
          <p class="text-navy/60 mb-4">Breathwork, meditation, somatic relaxation, and burnout prevention for high-pressure teams.</p>
          <a href="/workshops" class="text-teal font-medium text-sm hover:text-teal-light transition-colors">Learn more &rarr;</a>
        </div>

        <!-- Workshop 3 -->
        <div class="bg-white border border-navy/10 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-full bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-3">Time Management & Mental Focus</h3>
          <p class="text-navy/60 mb-4">Strategies for sustained attention, prioritization, and deep work in distraction-heavy environments.</p>
          <a href="/workshops" class="text-teal font-medium text-sm hover:text-teal-light transition-colors">Learn more &rarr;</a>
        </div>

        <!-- Workshop 4 -->
        <div class="bg-white border border-navy/10 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-full bg-teal/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-3">Meditation for Corporate Wellness</h3>
          <p class="text-navy/60 mb-4">A 2-hour experiential session introducing practical meditation techniques for the workplace.</p>
          <a href="/workshops" class="text-teal font-medium text-sm hover:text-teal-light transition-colors">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Strip -->
  <section class="py-16 bg-navy/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-medium text-navy/50 uppercase tracking-wider mb-8">Trusted by Leading Corporates</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {clients.map((client) => (
          <div class="text-center py-4 px-6 bg-white rounded-md shadow-sm">
            <span class="text-sm font-medium text-navy/70">{client}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-teal text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-bold mb-4">Ready to Transform Your Team?</h2>
      <p class="text-white/80 text-lg mb-8">
        Let's discuss how our corporate mind management programs can benefit your organisation.
      </p>
      <a href="/contact" class="inline-block bg-white text-teal font-semibold px-8 py-3 rounded-md hover:bg-cream transition-colors">
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
