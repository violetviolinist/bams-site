---
interface Props {
  title: string;
  message?: string;
}

const { title, message = "We're working on this section. Check back soon." } = Astro.props;
---

<section class="py-24 px-4 text-center">
  <div class="max-w-2xl mx-auto">
    <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-cream flex items-center justify-center">
      <svg class="w-8 h-8 text-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-navy mb-4">{title}</h1>
    <p class="text-lg text-navy/60">{message}</p>
  </div>
</section>
